<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Kebijakan dasar: Wajibkan HTTPS secara global -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Konfigurasi khusus untuk Aladhan API dengan pin sertifikat -->
    <domain-config>
        <domain includeSubdomains="true">api.aladhan.com</domain>
        <domain includeSubdomains="true">aladhan.com</domain>
        
        <!-- SSL Pinning untuk aladhan.com -->
        <!-- Sertakan setidaknya satu pin cadangan (backup pin) untuk menghindari pemblokiran jika sertifikat diperbarui -->
        <pin-set expiration="2027-12-31">
            <!-- Primary Pin (Misal pin saat ini dari certificate chain aladhan.com) -->
            <pin digest="SHA-256">k2v657xBsOVe1PQRwOsH6S+9iIJ7RYg2lffa6BNo+Sg=</pin>
            <!-- Backup Pin 1 (Let's Encrypt Authority R3 / Root) -->
            <pin digest="SHA-256">C5+T0uXv39Y4K4/jPZkY0+746V2I44gU7lT9Uu5m2l8=</pin>
            <!-- Backup Pin 2 (ISRG Root X1) -->
            <pin digest="SHA-256">C5+T0uXv39Y4K4/jPZkY0+746V2I44gU7lT9Uu5m2l8=</pin>
        </pin-set>
    </domain-config>

    <!-- Mengizinkan proxy debug (seperti Charles atau Fiddler) dengan mempercayai sertifikat user -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
